#!/usr/bin/env bash
# Programmable stub for GitHub Projects v2 / Issues calls (spec 1.31).
#
# Put this directory FIRST on PATH and every `gh` invocation is recorded instead
# of executed:
#
#   PATH="$(git rev-parse --show-toplevel)/hooks/fixtures/gh-stub:$PATH" \
#   FLOW_GH_CAPTURE_LOG=/tmp/calls.log \
#   FLOW_GH_STUB_DIR=/tmp/responses     <run the thing under test>
#
# Then assert against the log — e.g. that a done-step issued exactly one
# `item-edit`, edited one comment, and touched no other field or item.
#
# Why this is NOT a copy of 1.27's `fixtures/ado-capture/az`: that double is
# documented as "exits 0 and prints nothing", which is enough because an ADO
# card write needs no return value. Here the read path is load-bearing — a
# Status write can only happen after `item-list`/`issue view` resolves the item,
# `/flow:init` builds its state_map from `field-list`, and the scope-gap and
# board-unreachable criteria need a real failure. So this one also ANSWERS:
# scripted stdout, stderr and exit status per invocation.
#
# Responses live in $FLOW_GH_STUB_DIR, keyed by the first two non-numeric,
# non-flag argv tokens joined with `-`:
#
#   project-field-list.out    stdout for `gh project field-list 36 --owner x`
#   project-view.err          stderr for `gh project view …`
#   project-view.exit         exit status for `gh project view …`
#   issue-view.out            stdout for `gh issue view 42 --json comments`
#
# Absent a response the call logs and exits 0 silently, so a caller that pipes
# or checks status behaves as it would against a successful real call. A global
# $FLOW_GH_STUB_EXIT covers the blunt "gh is broken/unavailable" case.
#
# LIMIT, by design: the key deliberately ignores all-digit tokens, so an item or
# issue number is NOT part of it — every `issue view <n>` in one run gets the
# same canned answer. Cases that must differ per item (one per Status column, a
# closed not_planned, an unmapped column) each need their own
# $FLOW_GH_STUB_DIR; they cannot share one run.
#
# It is a durable fixture, not scratch, and it never reaches the network: there
# is no fallthrough to the real `gh` anywhere below. `hooks/CLAUDE.md`'s "board
# data is an input, never a query" rule is untouched — no preflight subcommand
# gains a call because this exists.

set -u
LOG="${FLOW_GH_CAPTURE_LOG:-${TMPDIR:-/tmp}/flow-gh-capture.log}"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true

# One line per call, argv space-joined. Arguments containing spaces are quoted
# so a reader can tell `--value "In Progress"` from two separate arguments.
line="gh"
for a in "$@"; do
    case "$a" in
        *[[:space:]]*) line="$line \"$a\"" ;;
        *)             line="$line $a" ;;
    esac
done
printf '%s\n' "$line" >> "$LOG"

# Response key: leading argv tokens up to the first flag or bare number, max 2.
# `gh project field-list 36 --owner x` -> project-field-list
# `gh issue view 42 --json comments`   -> issue-view
key=""
count=0
for a in "$@"; do
    case "$a" in
        -*)       break ;;   # a flag: the subcommand path has ended
        *[!0-9]*) ;;         # has a non-digit: part of the subcommand
        *)        break ;;   # all digits: an id, not a subcommand
    esac
    key="${key:+$key-}$a"
    count=$((count + 1))
    [ "$count" -ge 2 ] && break
done
# A `gh api repos/o/r/issues/1/comments` token carries slashes, which would
# resolve to a nested path that cannot exist — the stub would then log, exit 0
# and hand back empty stdout, which a caller reads as "no comments" rather than
# as a failure. Flatten so such a call keys to one real file.
key=$(printf '%s' "$key" | tr '/' '-')

DIR="${FLOW_GH_STUB_DIR:-}"
rc="${FLOW_GH_STUB_EXIT:-0}"

if [ -n "$DIR" ] && [ -n "$key" ]; then
    [ -f "$DIR/$key.out" ] && cat "$DIR/$key.out"
    [ -f "$DIR/$key.err" ] && cat "$DIR/$key.err" >&2
    # A per-key exit beats the global one: a run usually needs most calls to
    # succeed and exactly one to fail.
    if [ -f "$DIR/$key.exit" ]; then
        rc=$(tr -dc '0-9' < "$DIR/$key.exit")
        rc="${rc:-0}"
    fi
fi

exit "$rc"
